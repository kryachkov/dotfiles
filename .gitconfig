[diff "sopsdiffer"]
	textconv = sops -d

[merge]
  tool = nvimdiff
[mergetool]
	keepBackup = true
[push]
	default = simple
[core]
	editor = nvim
[diff "ansible-vault"]
  textconv = "ansible-vault view"
[color]
	ui = true
  interactive = true
  diff = true
[pull]
	ff = only
	rebase = true
[commit]
	gpgsign = true
  verbose = true
[alias]
  branch-name = "!git rev-parse --abbrev-ref HEAD"
  publish = "!git push -u origin $(git branch-name)"
	please = push --force-with-lease
[status]
	relativePaths = true
[init]
	defaultBranch = master


[core]
    quotePath = false
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    light = true      # or light = true, or omit for auto-detection
    line-numbers = true

[merge]
    conflictstyle = zdiff3
[credential]
  helper = store --file ~/.config/git/credentials

[include]
  path = ~/.config/git/local
